# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Avoid "$" in values (Docker Compose treats it as a variable reference).

# --- Unraid / host ---
# Where MySQL keeps its data on the host.
APPDATA_DIR=/mnt/user/appdata/home-builder
# Name of the Docker network your existing cloudflared container is on.
# Find it with: docker inspect <cloudflared-container> --format '{{json .NetworkSettings.Networks}}'
CLOUDFLARED_NETWORK=
TZ=UTC

# --- Image ---
APP_IMAGE=ghcr.io/thegspiro/home-builder-app
APP_IMAGE_TAG=latest

# --- Cloudflare Access ---
# The public hostname you route to this app in your tunnel, as seen by the browser.
# In the tunnel's public hostname settings, point it at http://app:8080
# (cloudflared reaches the app by its service name on the shared network).
PUBLIC_ORIGIN=https://videos.example.com
# Zero Trust dashboard > Settings > Custom pages: "<team>.cloudflareaccess.com" (no https://)
CF_ACCESS_TEAM_DOMAIN=
# Zero Trust dashboard > Access > Applications > your app > Overview: "Application Audience (AUD) Tag"
CF_ACCESS_AUD=

# --- Permissions ---
# Comma-separated emails that can edit the shared library and create houses.
ADMIN_EMAILS=

# --- Database ---
DATABASE_NAME=homebuilder
DATABASE_USER=homebuilder
# Generate with: openssl rand -hex 24
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=

LOG_LEVEL=info
